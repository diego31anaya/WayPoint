# local = real LA places from ../data/la_places.csv.gz; mock = synthetic Pomona; live = Snowflake view
DATA_MODE=local
# With DATA_MODE=live: true = fall back to the local export (labeled data_source=local) if Snowflake fails
LOCAL_FALLBACK=true
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_S=45
OLLAMA_RETRIES=1
OLLAMA_TEMPERATURE=0
OLLAMA_THINK=false
# JSON array; backend CORS only. Streamlit server-side calls do not need CORS.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# Set these after inspecting the actual listing. View must expose the canonical columns documented in README.
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_TABLE=
# For the view in sql/waypoint_places_view.sql: SNOWFLAKE_DATABASE=WAYPOINT, SNOWFLAKE_SCHEMA=PUBLIC, SNOWFLAKE_TABLE=WAYPOINT_PLACES
SNOWFLAKE_MAPPING_VERIFIED=false
DATASET_RELEASE=unverified
