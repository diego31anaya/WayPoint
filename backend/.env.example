# local = real LA places from ../data/la_places.csv.gz; mock = synthetic Pomona; live = Snowflake view
DATA_MODE=local
# With DATA_MODE=live: true = fall back to the local export (labeled data_source=local) if Snowflake fails
LOCAL_FALLBACK=true
AI_ENABLED=false
AI_PROVIDER=snowflake_cortex
SNOWFLAKE_CORTEX_MODEL=llama3.3-70b
CORTEX_TIMEOUT_S=60
CORTEX_TEMPERATURE=0
CORTEX_RETRIES=1
CORTEX_ALLOW_LEGACY=false
CORTEX_ALLOW_CROSS_REGION=false
# Add only models whose actual open-weight license has been verified.
CORTEX_OPEN_WEIGHT_MODELS=["llama3.3-70b"]
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_TABLE=
# For the view in sql/waypoint_places_view.sql: SNOWFLAKE_DATABASE=WAYPOINT, SNOWFLAKE_SCHEMA=PUBLIC, SNOWFLAKE_TABLE=WAYPOINT_PLACES
SNOWFLAKE_MAPPING_VERIFIED=false
DATASET_RELEASE=unverified
SNOWFLAKE_AGENT_DATABASE=WAYPOINT
SNOWFLAKE_AGENT_SCHEMA=PUBLIC
SNOWFLAKE_AGENT_NAME=BUSINESS_ADVISOR
SNOWFLAKE_AGENT_TOOL_NAME=BUSINESS_ANALYTICS
SNOWFLAKE_SEMANTIC_VIEW=WAYPOINT.PUBLIC.BUSINESS_ANALYTICS
SNOWFLAKE_CONTEXT_VIEW=NEIGHBORHOOD_CONTEXT
SNOWFLAKE_AGENT_SETUP_VERIFIED=false
SNOWFLAKE_ACCOUNT_BASE_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_AGENT_TIMEOUT_S=180
# Legacy token setting remains accepted; SNOWFLAKE_PAT takes precedence.
SNOWFLAKE_AGENT_TOKEN=
SNOWFLAKE_AGENT_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
